---
/** Einbettbare Seite (iframe): Rechner ohne Navigation. noindex, nicht in der Sitemap (astro.config). ?lang=en schaltet die Sprache um. */
import '../../styles/global.css';
import ThgRechner from '../../components/calc/ThgRechner';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
const de = route('thg-praemie', 'de'), en = route('thg-praemie', 'en');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>THG-Prämie 2026</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${de}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <div id="de-view"><ThgRechner client:load lang="de" /></div>
    <div id="en-view" hidden><ThgRechner client:load lang="en" /></div>
    <p class="mt-2 text-center text-xs text-navy-600"><a id="credit" href={`${SITE_URL}${de}`} data-en={`${SITE_URL}${en}`} target="_blank" rel="noopener" class="underline">THG-Prämie 2026 · Stromerprämie</a></p>
    <script is:inline>
      if (new URLSearchParams(location.search).get('lang') === 'en') { document.getElementById('de-view').hidden = true; document.getElementById('en-view').hidden = false; document.documentElement.lang = 'en'; var c = document.getElementById('credit'); c.textContent = 'GHG quota payout 2026 · Stromerprämie'; c.href = c.dataset.en; }
    </script>
  </body>
</html>
