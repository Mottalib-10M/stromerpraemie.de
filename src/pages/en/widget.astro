---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const q = lang === 'en' ? '?lang=en' : '';
const code = `<iframe src="${SITE_URL}/embed/praemienrechner/${q}" title="EV grant calculator" width="100%" height="1150" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/thg-praemie/${q}" title="GHG quota payout" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the German EV grant calculator: grant and GHG quota" description="Embed the 2026 German EV grant calculator with the price after the grant, or the GHG quota calculator, free of charge by iframe: copy the code, no cookies, two languages." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the German EV grant calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For motoring clubs, energy suppliers, councils and local newsrooms: copy once, and grant amounts and list prices update themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>EV grant calculator</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>GHG quota payout</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>Terms: the source link under the calculator stays visible, the calculator is not altered and is provided without warranty. Add <code>?lang=en</code> for the English version. What your readers type stays on their device.</p>
    <p>Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/praemienrechner/${q}`} title="EV grant calculator" width="100%" height="1150" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
